<title>縱谷三日 — 太麻里到花蓮</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#182821;
    --ink-soft:#24382f;
    --moss:#3f5c48;
    --gold:#e3a857;
    --persimmon:#c1592f;
    --paper:#f1ead3;
    --paper-dim:#d9d0af;
    --line: rgba(241,234,211,0.16);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth; background:#182821;}
  body{
    background-color:#182821;
    background-image:
      radial-gradient(ellipse at 20% -10%, rgba(227,168,87,0.10), transparent 45%),
      radial-gradient(ellipse at 90% 10%, rgba(193,89,47,0.08), transparent 40%);
    color:var(--paper);
    font-family:'Noto Sans TC', sans-serif;
    line-height:1.65;
    padding-bottom:6rem;
    min-height:100vh;
  }
  .mono{font-family:'JetBrains Mono', monospace; letter-spacing:0.02em;}

  /* ===== HERO ===== */
  header.hero{
    position:relative;
    padding: 4.5rem 1.5rem 3.5rem;
    text-align:center;
    overflow:hidden;
    border-bottom:1px solid var(--line);
  }
  header.hero .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:0.75rem;
    letter-spacing:0.35em;
    color:var(--gold);
    text-transform:uppercase;
    margin-bottom:1.2rem;
  }
  header.hero h1{
    font-family:'Noto Serif TC', serif;
    font-weight:900;
    font-size:clamp(2.4rem, 7vw, 4.2rem);
    line-height:1.15;
    background:linear-gradient(100deg, var(--paper) 20%, var(--gold) 55%, var(--persimmon) 85%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  header.hero p.sub{
    margin-top:1.1rem;
    font-size:1.05rem;
    color:var(--paper-dim);
  }
  .range-svg{ width:100%; max-width:900px; margin:2.8rem auto 0; display:block; opacity:0.9;}

  /* ===== DAY NAV ===== */
  nav.daynav{
    display:flex; flex-direction:column; align-items:center; gap:0.6rem;
    padding:1.4rem 1rem; position:sticky; top:0; z-index:20;
    background:rgba(24,40,33,0.88); backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .daynav-row{ display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap; }
  nav.daynav a{
    color:var(--paper); text-decoration:none;
    font-family:'JetBrains Mono', monospace; font-size:0.8rem; letter-spacing:0.08em;
    padding:0.5rem 1.1rem; border:1px solid var(--line); border-radius:999px;
    transition: all 0.2s ease;
  }
  nav.daynav a:hover{ border-color:var(--gold); color:var(--gold); }

  /* ===== DAY SECTION ===== */
  section.day{ max-width:760px; margin:0 auto; padding:3.5rem 1.3rem 1rem; scroll-margin-top:5.5rem; }
  .day-head{ display:flex; align-items:baseline; gap:1rem; margin-bottom:0.4rem; }
  .day-head .num{
    font-family:'Noto Serif TC', serif; font-weight:900; font-size:3rem; color:var(--gold);
  }
  .day-head .titles h2{ font-family:'Noto Serif TC', serif; font-size:1.5rem; font-weight:700; }
  .day-head .titles .date{ font-family:'JetBrains Mono', monospace; font-size:0.8rem; color:var(--paper-dim); }
  .day-desc{ color:var(--paper-dim); font-size:0.92rem; margin:0.8rem 0 2.2rem; max-width:56ch; }

  /* ===== TIMELINE ===== */
  .timeline{ position:relative; padding-left:2.1rem; }
  .timeline::before{
    content:''; position:absolute; left:0.45rem; top:0.4rem; bottom:0.4rem; width:1px;
    background:linear-gradient(var(--gold), var(--moss));
  }
  .stop{ position:relative; padding-bottom:2.1rem; }
  .stop::before{
    content:''; position:absolute; left:-2.1rem; top:0.35rem; width:9px; height:9px;
    border-radius:50%; background:var(--gold); box-shadow:0 0 0 4px rgba(227,168,87,0.15);
  }
  .stop.meal::before{ background:var(--persimmon); box-shadow:0 0 0 4px rgba(193,89,47,0.18); }
  .stop-card{
    background:rgba(241,234,211,0.04);
    border:1px solid var(--line);
    border-radius:10px;
    padding:1.1rem 1.2rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .stop-card:hover{ border-color: rgba(227,168,87,0.4); background:rgba(241,234,211,0.06); }
  .stop-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:0.8rem; flex-wrap:wrap; }
  .stop-name{ font-family:'Noto Serif TC', serif; font-weight:700; font-size:1.08rem; }
  .stop-tag{
    font-family:'JetBrains Mono', monospace; font-size:0.68rem; letter-spacing:0.06em;
    color:var(--ink); background:var(--gold); padding:0.15rem 0.5rem; border-radius:5px;
    white-space:nowrap; height:fit-content;
  }
  .stop.meal .stop-tag{ background:var(--persimmon); color:var(--paper); }
  .stop-addr{ font-size:0.82rem; color:var(--paper-dim); margin-top:0.35rem; }
  .stop-note{ font-size:0.85rem; color:var(--paper-dim); margin-top:0.5rem; line-height:1.6; }
  .stop-note b{ color:var(--gold); font-weight:500; }
  .nav-btn{
    display:inline-flex; align-items:center; gap:0.4rem;
    margin-top:0.85rem; font-family:'JetBrains Mono', monospace; font-size:0.75rem;
    color:var(--ink); background:var(--paper); text-decoration:none;
    padding:0.42rem 0.8rem; border-radius:999px; font-weight:500;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .nav-btn:hover{ background:var(--gold); transform:translateY(-1px); }
  .nav-btn svg{ width:13px; height:13px; }

  /* divider between days */
  .valley-divider{ width:100%; max-width:760px; margin:1rem auto 0; display:block; opacity:0.7; }

  footer{ text-align:center; padding:3rem 1.5rem 1rem; color:var(--paper-dim); font-size:0.78rem; }
  footer a{ color:var(--gold); }

  /* ===== EXPENSES ===== */
  .settle-summary{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr));
    gap:0.9rem; margin-bottom:2.4rem;
  }
  .settle-card{
    background:linear-gradient(135deg, rgba(227,168,87,0.10), rgba(193,89,47,0.06));
    border:1px solid rgba(227,168,87,0.3);
    border-radius:10px; padding:1.1rem 1.2rem;
  }
  .settle-card .flow{ font-family:'JetBrains Mono', monospace; font-size:0.78rem; color:var(--paper-dim); }
  .settle-card .flow b{ color:var(--paper); font-weight:700; }
  .settle-card .amount{
    font-family:'Noto Serif TC', serif; font-weight:900; font-size:1.7rem; color:var(--gold);
    margin-top:0.3rem;
  }

  .detail-block{ margin-bottom:2.2rem; }
  .detail-block h3{
    font-family:'Noto Serif TC', serif; font-size:1.05rem; font-weight:700;
    color:var(--gold); margin-bottom:0.3rem;
  }
  .detail-block .desc{ font-size:0.82rem; color:var(--paper-dim); margin-bottom:0.9rem; }
  table.ledger{
    width:100%; border-collapse:collapse; font-size:0.86rem;
    background:rgba(241,234,211,0.03); border:1px solid var(--line); border-radius:8px; overflow:hidden;
  }
  table.ledger th, table.ledger td{
    padding:0.55rem 0.8rem; text-align:left; border-bottom:1px solid var(--line);
  }
  table.ledger th{
    font-family:'JetBrains Mono', monospace; font-size:0.7rem; letter-spacing:0.06em;
    color:var(--paper-dim); text-transform:uppercase; font-weight:500;
  }
  table.ledger td.amt, table.ledger th.amt{ text-align:right; font-family:'JetBrains Mono', monospace; }
  table.ledger tr:last-child td{ border-bottom:none; }
  table.ledger tr.total td{
    font-weight:700; color:var(--gold); border-top:1px solid rgba(227,168,87,0.4);
  }
  .settle-note{
    margin-top:0.7rem; font-size:0.82rem; color:var(--paper-dim);
    border-left:2px solid var(--gold); padding-left:0.8rem;
  }
  .settle-note b{ color:var(--paper); font-weight:500; }
  @media (max-width:480px){
    table.ledger{ font-size:0.78rem; }
    table.ledger th, table.ledger td{ padding:0.45rem 0.5rem; }
  }

  @media (max-width:480px){
    .day-head .num{ font-size:2.3rem; }
    .stop-card{ padding:0.9rem 1rem; }
  }
</style>
</head>
