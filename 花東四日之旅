function fmt(n){ return n.toLocaleString('zh-Hant-TW'); }

function ledgerTable(rows, totalLabel){
  const total = rows.reduce((s,r)=>s+r[2],0);
  return `<table class="ledger">
    <thead><tr><th>日期</th><th>項目</th><th class="amt">金額</th></tr></thead>
    <tbody>
      ${rows.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td><td class="amt">${fmt(r[2])}</td></tr>`).join('')}
      <tr class="total"><td colspan="2">${totalLabel}</td><td class="amt">${fmt(total)}</td></tr>
    </tbody>
  </table>`;
}

